# Auto detect text files; check out LF everywhere (Windows CI compares bytes).
* text=auto eol=lf
*.css linguist-detectable=false  
*.js linguist-detectable=false  
*.html linguist-detectable=false 
*.ps1 linguist-detectable=false 
*.png binary
*.ico binary
*.icns binary

# Vendored trees stay out of GitHub language stats (Linguist).
third_party/** linguist-vendored

# ThrowTheSwitch Unity (test harness). unity_internals.h is what
# Linguist was counting as C++ (~100 KB / ~5%).
tests/unity/framework/** linguist-vendored
