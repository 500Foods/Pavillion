if(NOT DEFINED FUNC)
    set(FUNC pav_migration_table)
endif()
if(NOT DEFINED DIR OR NOT DEFINED OUT)
    message(FATAL_ERROR "embed_sql.cmake needs DIR and OUT")
endif()

file(GLOB SQLS LIST_DIRECTORIES false "${DIR}/*.sql")
list(SORT SQLS)

set(BODY "")
string(APPEND BODY "#include \"migrations_embed.h\"\n\n")

set(ROWS "")
set(N 0)
foreach(SQL ${SQLS})
    math(EXPR N "${N} + 1")
    get_filename_component(BASE "${SQL}" NAME)
    string(REGEX MATCH "^([0-9]+)" VER "${BASE}")
    if(VER STREQUAL "")
        message(FATAL_ERROR "migration name must start with digits: ${BASE}")
    endif()
    math(EXPR VERSION "${VER}")
    file(READ "${SQL}" HEX HEX)
    string(LENGTH "${HEX}" HEXLEN)
    math(EXPR BYTES "${HEXLEN} / 2")
    string(APPEND BODY "static const unsigned char k_sql_${N}[] = {\n")
    set(COL 0)
    if(BYTES GREATER 0)
        foreach(I RANGE 0 ${BYTES})
            if(I EQUAL BYTES)
                break()
            endif()
            math(EXPR POS "${I} * 2")
            string(SUBSTRING "${HEX}" ${POS} 2 PAIR)
            string(APPEND BODY "0x${PAIR},")
            math(EXPR COL "${COL} + 1")
            if(COL EQUAL 16)
                string(APPEND BODY "\n")
                set(COL 0)
            endif()
        endforeach()
    endif()
    string(APPEND BODY "0\n};\n")
    string(APPEND BODY "static const char k_set_${N}[] = \"PRAGMA user_version = ${VERSION}\";\n\n")
    string(APPEND ROWS "    { ${VERSION}, \"${BASE}\", (const char *)k_sql_${N}, k_set_${N} },\n")
endforeach()

string(APPEND BODY "static const PavMigration k_table[] = {\n")
if(N EQUAL 0)
    string(APPEND BODY "    { 0, \"\", \"\", \"PRAGMA user_version = 0\" }\n")
else()
    string(APPEND BODY "${ROWS}")
endif()
string(APPEND BODY "};\n\n")
string(APPEND BODY "const PavMigration *${FUNC}(int *count) {\n")
string(APPEND BODY "    if (count != 0) {\n")
string(APPEND BODY "        *count = ${N};\n")
string(APPEND BODY "    }\n")
string(APPEND BODY "    return k_table;\n")
string(APPEND BODY "}\n")

file(WRITE "${OUT}" "${BODY}")
