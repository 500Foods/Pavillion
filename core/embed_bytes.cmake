if(NOT DEFINED SRC OR NOT DEFINED OUT OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR "embed_bytes.cmake needs SRC, OUT, and SYMBOL")
endif()

file(READ "${SRC}" HEX HEX)
string(LENGTH "${HEX}" HEXLEN)
math(EXPR BYTES "${HEXLEN} / 2")
string(REGEX REPLACE "([0-9a-fA-F][0-9a-fA-F])" "0x\\1," FLAT "${HEX}")
string(LENGTH "${FLAT}" FLATLEN)
set(WRAPPED "")
set(POS 0)
set(CHUNK 4000)
while(POS LESS FLATLEN)
    string(SUBSTRING "${FLAT}" ${POS} ${CHUNK} PIECE)
    string(APPEND WRAPPED "${PIECE}\n")
    math(EXPR POS "${POS} + ${CHUNK}")
endwhile()
file(WRITE "${OUT}" "#include \"icon_mark.h\"\n\nconst unsigned char ${SYMBOL}[] = {\n${WRAPPED}};\nconst size_t ${SYMBOL}_len = ${BYTES};\n")
